# vlade-postgres-bm25: vlade-postgres plus pg_search (ParadeDB) for the bm25 retriever (ADR-0005, ADR-0022).
# pg_search uses the AGPL-3.0 license. It runs inside this separate PostgreSQL process, unmodified.
# The Vlade-RAG Python package does not include it (VLADE-RAG.md section 16.1, item 4).
# Build: docker build -f deploy/postgres/Dockerfile.bm25 -t vlade-postgres-bm25:17 deploy/postgres
FROM pgvector/pgvector:0.8.7-pg17-trixie

ARG PG_SEARCH_VERSION=0.27.0
ARG PG_SEARCH_SHA256_AMD64=70a38b6098a61cdc3c06057acf2c8d40988b1e8db55c5f9a567cfd3f12bef023
ARG PG_SEARCH_SHA256_ARM64=a2c54b7eb1d3d2dff569fa8756e0390c7e9954d98d0014d15526b95a7563da41
ARG TARGETARCH

RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) sha="${PG_SEARCH_SHA256_AMD64}" ;; \
      arm64) sha="${PG_SEARCH_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    deb="/tmp/postgresql-17-pg-search_${PG_SEARCH_VERSION}-1PARADEDB-trixie_${TARGETARCH:-amd64}.deb"; \
    curl -fsSL -o "$deb" \
      "https://github.com/paradedb/paradedb/releases/download/v${PG_SEARCH_VERSION}/$(basename "$deb")"; \
    echo "${sha}  ${deb}" | sha256sum -c -; \
    apt-get install -y --no-install-recommends "$deb"; \
    rm -f "$deb"; \
    apt-get purge -y --auto-remove curl; \
    rm -rf /var/lib/apt/lists/*

COPY initdb/ /docker-entrypoint-initdb.d/
COPY initdb-bm25/ /docker-entrypoint-initdb.d/

# pg_search must be loaded at start-up. The entrypoint passes these arguments to the init server too.
CMD ["postgres", "-c", "shared_preload_libraries=pg_search"]

{
  "language": "pt",
  "chunking": {"strategy": "markdown", "max_tokens": 400, "overlap_tokens": 40},
  "embeddings": {
    "provider": "openrouter",
    "model": "openai/text-embedding-3-small",
    "dimension": 1536,
    "batch_size": 64
  },
  "generation": {
    "provider": "openrouter",
    "model": "provedor/modelo",
    "temperature": 0.1,
    "max_context_tokens": 6000,
    "max_output_tokens": 800
  }
}

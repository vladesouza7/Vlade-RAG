# Copie este arquivo para .env e preencha os valores vazios.
# Não faça commit do arquivo .env.

VLADE_ENVIRONMENT=dev
VLADE_LOG_LEVEL=INFO

# Docker Compose: senhas e segredos (obrigatórios)
POSTGRES_PASSWORD=
VLADE_APP_DB_PASSWORD=
VLADE_API_KEY_PEPPER=

# Provedores de modelos
# Ollama na máquina local: http://host.docker.internal:11434
# Ollama do Compose (--profile ollama): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Portas no host. Mude se a porta já estiver em uso.
VLADE_API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6379
OLLAMA_HOST_PORT=11434

# Copie este arquivo para .env e preencha os valores vazios.
# Não faça commit do arquivo .env.

VLADE_ENVIRONMENT=dev
VLADE_LOG_LEVEL=INFO

# Docker Compose: senhas e segredos (obrigatórios)
POSTGRES_PASSWORD=
VLADE_APP_DB_PASSWORD=
VLADE_API_KEY_PEPPER=

# OIDC/OAuth 2.1 na API e no MCP (ADR-0031). Desligado por padrão. As chaves de API continuam
# funcionando quando ligado. Instale o extra "oidc" para verificar tokens.
# VLADE_AUTH__OIDC__ENABLED=true
# VLADE_AUTH__OIDC__ISSUER=https://idp.exemplo
# VLADE_AUTH__OIDC__AUDIENCE=vlade-rag
# VLADE_AUTH__OIDC__JWKS_URL=https://idp.exemplo/.well-known/jwks.json
# VLADE_AUTH__OIDC__ALGORITHMS=["RS256"]
# VLADE_AUTH__OIDC__TENANT_CLAIM=tenant
# VLADE_AUTH__OIDC__ROLES_CLAIM=roles

# Provedores de modelos remotos. Preencha a chave do provedor que você usa.
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OPENAI_API_KEY=
# Gemini (API compatível com a da OpenAI). Veja os modelos em
# https://generativelanguage.googleapis.com/v1beta/openai/models (cabeçalho Authorization: Bearer).
# GEMINI_EMBEDDING_DIMENSIONS=true envia "dimensions" nos embeddings. A documentação do Google não
# confirma esse campo no endpoint compatível: teste antes de ligar.
GEMINI_API_KEY=
# GEMINI_EMBEDDING_DIMENSIONS=false

# Configuração padrão das bases novas (JSON numa linha).
# Exemplo com OpenRouter para embeddings e geração. Troque o modelo de geração por um modelo
# da lista em https://openrouter.ai/models. Para OpenCode, use "provider": "opencode".
VLADE_DEFAULT_KB_CONFIG={"embeddings": {"provider": "openrouter", "model": "openai/text-embedding-3-small", "dimension": 1536}, "generation": {"provider": "openrouter", "model": "provedor/modelo"}}

# Outro provedor compatível com a API da OpenAI (opcional). O nome vira o "provider".
# VLADE_PROVIDERS__COMPATIBLE__GROQ__BASE_URL=https://api.groq.com/openai/v1
# VLADE_PROVIDERS__COMPATIBLE__GROQ__API_KEY=

# Índice vetorial. O padrão é pgvector no PostgreSQL (ADR-0004). Para usar o Qdrant, instale o
# extra "qdrant", ligue o backend e preencha a URL. O pgvector continua como referência.
# VLADE_VECTOR_INDEX__BACKEND=qdrant
# VLADE_VECTOR_INDEX__QDRANT__URL=http://localhost:6333
# VLADE_VECTOR_INDEX__QDRANT__API_KEY=
# VLADE_VECTOR_INDEX__QDRANT__COLLECTION_PREFIX=vlade_

# Conectores de origem (ADR-0028 e ADR-0029). Todos desligados por padrão.
# VLADE_SOURCES__ALLOWED_DOMAINS=["docs.exemplo.com"]   # necessário para https:// e para o conector de sites
# VLADE_SOURCES__MAX_BYTES=52428800
# VLADE_SOURCES__TIMEOUT=30.0
# VLADE_SOURCES__WEB__SEEDS=["https://docs.exemplo.com"]
# VLADE_SOURCES__WEB__MAX_PAGES=50
# VLADE_SOURCES__WEB__MAX_DEPTH=2
# VLADE_SOURCES__GOOGLE_DRIVE__ACCESS_TOKEN=            # token OAuth de acesso; renove no cofre
# VLADE_SOURCES__GOOGLE_DRIVE__FOLDER_ID=root
# VLADE_SOURCES__SQL__URL=postgresql+asyncpg://***      # banco externo; use uma conta somente leitura
# VLADE_SOURCES__SQL__QUERY=SELECT id, title FROM documentos
# VLADE_SOURCES__SQL__FILENAME_COLUMNS=["title"]        # instale o extra "sql" para usar este conector

# Cache e limite de requisições. O Compose já usa o serviço valkey. Deixe vazio para manter os dois
# dentro do processo da API (sem compartilhar entre processos).
# VLADE_CACHE__URL=redis://valkey:6379/0
# Cache semântico de consultas (ADR-0030). Desligado por padrão.
# VLADE_CACHE__SEMANTIC__ENABLED=true
# VLADE_CACHE__SEMANTIC__THRESHOLD=0.98       # similaridade mínima entre perguntas
# VLADE_CACHE__SEMANTIC__MAX_ENTRIES=128      # perguntas guardadas por base
# VLADE_CACHE__SEMANTIC__TTL_SECONDS=600

# Armazenamento dos arquivos originais. O padrão é um volume (filesystem). Para usar a API S3 (AWS ou
# qualquer serviço compatível), preencha o bucket e o resto e troque o backend para s3 (ADR-0006).
# VLADE_OBJECT_STORAGE__BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=          # vazio na AWS; a URL do serviço compatível nos outros casos
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=         # vazio: usa a cadeia padrão do boto3 (variáveis, arquivo, papel da instância)
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true
# S3_CREATE_BUCKET=false    # true cria o bucket ao iniciar. Use só com um serviço local
#
# Retriever bm25 (pg_search, ADR-0022). A imagem vlade-postgres-bm25 inclui o pg_search, com licença
# AGPL-3.0. O pg_search roda dentro do PostgreSQL, sem modificação, e não entra no pacote Python.
# Um volume existente mantém os dados. A primeira busca bm25 cria a extensão e o índice.
# POSTGRES_DOCKERFILE=Dockerfile.bm25
# POSTGRES_IMAGE=vlade-postgres-bm25:17
#
# Arize Phoenix local (ADR-0026): docker compose --profile dev --profile phoenix up
# Interface em http://127.0.0.1:6006. O Phoenix usa a Elastic License 2.0 e roda como serviço separado.
# VLADE_OTEL__ENABLED=true
# VLADE_OTEL__ENDPOINT=http://phoenix:6006
# VLADE_OTEL__METRICS=false              # o Phoenix recebe só traces
# VLADE_LIMITS__STORE_QUERY_TEXT=false   # true põe perguntas, respostas e chunks nos traces (dados pessoais)
# Para ligar a autenticação do Phoenix, use um docker-compose.override.yml com PHOENIX_ENABLE_AUTH=true
# e PHOENIX_SECRET. Depois defina PHOENIX_API_KEY e OTEL_EXPORTER_OTLP_HEADERS (ADR-0026).
#
# RustFS local (ADR-0021): docker compose --profile dev --profile s3 up
# As duas credenciais abaixo também configuram o container do RustFS. Ele não inicia com uma credencial vazia.
# VLADE_OBJECT_STORAGE__BACKEND=s3
# S3_BUCKET=vlade-objects
# S3_ENDPOINT_URL=http://rustfs:9000
# S3_ACCESS_KEY_ID=vlade-local
# S3_SECRET_ACCESS_KEY=        # uma senha longa
# S3_CREATE_BUCKET=true
# S3_HOST_PORT=9000            # porta da API S3 no host
# S3_CONSOLE_HOST_PORT=9001    # porta do console no host, com RUSTFS_CONSOLE_ENABLE=true

# Ollama (opcional, roda modelos na máquina local e exige muita memória)
# Ollama na máquina local: http://host.docker.internal:11434
# Ollama do Compose (--profile ollama): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Portas no host. Mude se a porta já estiver em uso.
VLADE_API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6379
OLLAMA_HOST_PORT=11434
QDRANT_HOST_PORT=6333

# Observabilidade (ADR-0015). O perfil prod sobe Alloy, Prometheus, Loki, Tempo e Grafana.
# A aplicação envia OTLP ao Alloy quando VLADE_OTEL__ENABLED=true.
# VLADE_OTEL__ENABLED=true
# VLADE_OTEL__ENDPOINT=http://alloy:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=          # troque no perfil prod; o padrão é admin
PROMETHEUS_RETENTION=15d
ALLOY_OTLP_GRPC_HOST_PORT=4317
ALLOY_OTLP_HTTP_HOST_PORT=4318
ALLOY_UI_HOST_PORT=12345
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
GRAFANA_HOST_PORT=3000
NODE_EXPORTER_HOST_PORT=9100
CADVISOR_HOST_PORT=8080
POSTGRES_EXPORTER_HOST_PORT=9187
REDIS_EXPORTER_HOST_PORT=9121
# Perfil staging: só o Alloy sobe. Aponte as URLs para os backends externos.
# PROMETHEUS_REMOTE_WRITE_URL=https://prometheus.exemplo/api/v1/write
# LOKI_PUSH_URL=https://loki.exemplo/loki/api/v1/push
# TEMPO_OTLP_ENDPOINT=tempo.exemplo:4317
# Perfil prod: o RustFS envia telemetria ao Alloy por OTLP quando esta variável está definida.
# RUSTFS_OBS_ENDPOINT=http://alloy:4318
